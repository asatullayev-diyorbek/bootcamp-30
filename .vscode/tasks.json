{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang build active file",
            "command": "/bin/sh",
            "args": [
                "-c",
                "mkdir -p \"${workspaceFolder}/build\" && exec /usr/bin/clang -fcolor-diagnostics -fansi-escape-codes -g \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
